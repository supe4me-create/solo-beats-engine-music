# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# local backups and temporary project files
*backup*.tsx
*.before-*
*.zip
*.rar
/add-*.mjs
/add-*.cjs
/register-*.mjs
/remove-*.mjs

# large audio preview files
*.wav

# SOLO BEATS local backups / patch artifacts
*.bak
*.backup
*.backup.*
*.before-*.tsx
*.before-*.ts
*.before-*.js
*.before-*.cjs
*.before-*.bak

# Temporary development files
tmp-*
*-target.txt
*-targets.txt
*-scan.txt

# Local patch scripts
tmp-*.cjs
tmp-*.js
tmp-*.ts
