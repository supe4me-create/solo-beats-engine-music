"use client";

import Link from "next/link";
import {
  PayPalButtons,
  PayPalScriptProvider,
} from "@paypal/react-paypal-js";
import {
  useCallback,
  useEffect,
  useMemo,
  useState,
} from "react";

import { useAuth } from "../../auth/AuthContext";

type CreditPack = {
  id:
    | "credits_10"
    | "credits_25"
    | "credits_50"
    | "credits_100";
  credits: number;
  price: number;
  label: string;
};

type Duration = "5" | "10";
type AspectRatio = "16:9" | "9:16";

type RecentJob = {
  id: string;
  mode?: string;
  prompt?: string;
  aspectRatio?: string;
  duration?: number;
  status?: string;
  progress?: number;
  provider?: string | null;
  providerJobId?: string | null;
  outputUrl?: string | null;
  error?: string | null;
  createdAt?: string | null;
  updatedAt?: string | null;
};
type GenerationMode =
  | "text"
  | "image"
  | "music";

type RecentJobFilter =
  | "all"
  | "completed"
  | "failed"
  | "hidden";

const OWNER_EMAIL =
  "supe4.me@gmail.com";

const paypalClientId = (
  process.env
    .NEXT_PUBLIC_PAYPAL_CLIENT_ID ||
  ""
).replace(/\s+/g, "");

function creditCost(
  duration: Duration
) {
  return duration === "5"
    ? 1
    : 2;
}

export default function PremiumAiVideoPage() {
  const {
    user,
    loading,
  } = useAuth();

  const isOwner =
    (user?.email || "")
      .toLowerCase() ===
    OWNER_EMAIL.toLowerCase();

  const [
    creditBalance,
    setCreditBalance,
  ] =
    useState<number | null>(
      null
    );

  const [
    packs,
    setPacks,
  ] =
    useState<CreditPack[]>([]);

  const [
    selectedPackId,
    setSelectedPackId,
  ] =
    useState<
      CreditPack["id"] | null
    >(null);

  const [
    creditsLoading,
    setCreditsLoading,
  ] =
    useState(false);

  const [
    creditError,
    setCreditError,
  ] =
    useState<string | null>(
      null
    );

  const [
    paymentMessage,
    setPaymentMessage,
  ] =
    useState<string | null>(
      null
    );

  const [
    generationMode,
    setGenerationMode,
  ] =
    useState<GenerationMode>(
      "text"
    );

  const [
    imageFile,
    setImageFile,
  ] =
    useState<File | null>(
      null
    );

  const [
    audioFile,
    setAudioFile,
  ] =
    useState<File | null>(
      null
    );

  const [
    prompt,
    setPrompt,
  ] =
    useState("");

  const [
    aspectRatio,
    setAspectRatio,
  ] =
    useState<AspectRatio>(
      "16:9"
    );

  const [
    duration,
    setDuration,
  ] =
    useState<Duration>(
      "10"
    );

  const [
    creating,
    setCreating,
  ] =
    useState(false);

  const [
    generationMessage,
    setGenerationMessage,
  ] =
    useState(
      "Ready to generate."
    );

  const [
    generationError,
    setGenerationError,
  ] =
    useState<string | null>(
      null
    );
  const AI_VIDEO_ACTIVE_JOB_KEY =
    "solo-beats-ai-video-active-job";

  const AI_VIDEO_LAST_OUTPUT_KEY =
    "solo-beats-ai-video-last-output";

  const AI_VIDEO_LAST_JOB_KEY =
    "solo-beats-ai-video-last-job";

  const AI_VIDEO_SAVED_MEDIA_KEY =
    "solo-beats-ai-video-saved-media";


  const [
    currentJobId,
    setCurrentJobId,
  ] =
    useState<string | null>(
      null
    );

  const [
    progress,
    setProgress,
  ] =
    useState(0);

  // RECENT_JOBS_UI_V2
  const [
    recentJobs,
    setRecentJobs,
  ] = useState<RecentJob[]>([]);

  const [
    recentJobsLoading,
    setRecentJobsLoading,
  ] = useState(false);

  const [
    recentJobsError,
    setRecentJobsError,
  ] = useState<string | null>(null);

  // HIDE_STALE_JOBS_V1
  const [
    hiddenRecentJobIds,
    setHiddenRecentJobIds,
  ] = useState<string[]>([]);

  const HIDDEN_RECENT_JOBS_KEY =
    "solo-beats-hidden-ai-video-jobs";

  // RECENT_JOB_FILTERS_V1
  const [
    recentJobFilter,
    setRecentJobFilter,
  ] =
    useState<RecentJobFilter>(
      "all"
    );

  // RECENT_JOBS_SEARCH_V1
  const [
    recentJobsSearch,
    setRecentJobsSearch,
  ] = useState("");

  // RECENT_JOBS_LOAD_MORE_V1
  const [
    recentJobsVisibleCount,
    setRecentJobsVisibleCount,
  ] = useState(6);

  const filteredRecentJobs =
    useMemo(
      () =>
        recentJobs.filter(
          (job) => {
            const isHidden =
              hiddenRecentJobIds.includes(
                job.id
              );

            if (
              recentJobFilter ===
              "hidden"
            ) {
              return isHidden;
            }

            if (isHidden) {
              return false;
            }

            if (
              recentJobFilter ===
              "completed"
            ) {
              return (
                job.status ===
                "completed"
              );
            }

            if (
              recentJobFilter ===
              "failed"
            ) {
              return [
                "failed",
                "canceled",
                "submission_unknown",
                "ready_for_provider",
              ].includes(
                job.status || ""
              );
            }

            return true;
          }
        ),
      [
        recentJobs,
        recentJobFilter,
        hiddenRecentJobIds,
      ]
    );

  const searchedRecentJobs =
    useMemo(
      () => {
        const query =
          recentJobsSearch
            .trim()
            .toLowerCase();

        if (!query) {
          return filteredRecentJobs;
        }

        return filteredRecentJobs.filter(
          (job) => {
            const searchable =
              [
                job.id,
                job.prompt,
                job.mode,
                job.status,
              ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase();

            return searchable.includes(
              query
            );
          }
        );
      },
      [
        filteredRecentJobs,
        recentJobsSearch,
      ]
    );



  const [
    outputUrl,
    setOutputUrl,
  ] =
    useState<string | null>(
      null
    );

  const [
    savingToVideoManager,
    setSavingToVideoManager,
  ] =
    useState(false);

  const [
    savedVideoMediaId,
    setSavedVideoMediaId,
  ] =
    useState<string | null>(
      null
    );

  const [
    saveVideoMessage,
    setSaveVideoMessage,
  ] =
    useState<string | null>(
      null
    );

  const [
    saveVideoError,
    setSaveVideoError,
  ] =
    useState<string | null>(
      null
    );

  useEffect(() => {
    if (!user) {
      return;
    }

    const savedOutputUrl =
      window.localStorage
        .getItem(
          `${AI_VIDEO_LAST_OUTPUT_KEY}:${user.uid}`
        )
        ?.trim() || "";

    if (!savedOutputUrl) {
      return;
    }

    const savedJobId =
      window.localStorage
        .getItem(
          `${AI_VIDEO_LAST_JOB_KEY}:${user.uid}`
        )
        ?.trim() || "";

    const savedMediaId =
      window.localStorage
        .getItem(
          `${AI_VIDEO_SAVED_MEDIA_KEY}:${user.uid}`
        )
        ?.trim() || "";

    setOutputUrl(
      savedOutputUrl
    );

    if (savedJobId) {
      setCurrentJobId(
        savedJobId
      );
    }

    if (savedMediaId) {
      setSavedVideoMediaId(
        savedMediaId
      );

      setSaveVideoMessage(
        "Video already saved permanently in Video Manager."
      );
    }

    setProgress(100);

    setGenerationMessage(
      "Last completed AI video restored."
    );
  }, [
    user,
  ]);



  useEffect(() => {
    if (!user) {
      setHiddenRecentJobIds([]);
      return;
    }

    try {
      const raw =
        window.localStorage.getItem(
          `${HIDDEN_RECENT_JOBS_KEY}:${user.uid}`
        );

      if (!raw) {
        setHiddenRecentJobIds([]);
        return;
      }

      const parsed =
        JSON.parse(raw);

      setHiddenRecentJobIds(
        Array.isArray(parsed)
          ? parsed.filter(
              (value) =>
                typeof value ===
                "string"
            )
          : []
      );
    } catch {
      setHiddenRecentJobIds([]);
    }
  }, [user]);

  function hideRecentJob(
    jobId: string
  ) {
    if (!user) {
      return;
    }

    setHiddenRecentJobIds(
      (current) => {
        const next =
          current.includes(jobId)
            ? current
            : [
                ...current,
                jobId,
              ];

        window.localStorage.setItem(
          `${HIDDEN_RECENT_JOBS_KEY}:${user.uid}`,
          JSON.stringify(next)
        );

        return next;
      }
    );
  }


  function unhideRecentJob(
    jobId: string
  ) {
    if (!user) {
      return;
    }

    setHiddenRecentJobIds(
      (current) => {
        const next =
          current.filter(
            (id) =>
              id !== jobId
          );

        if (next.length > 0) {
          window.localStorage.setItem(
            `${HIDDEN_RECENT_JOBS_KEY}:${user.uid}`,
            JSON.stringify(next)
          );
        } else {
          window.localStorage.removeItem(
            `${HIDDEN_RECENT_JOBS_KEY}:${user.uid}`
          );
        }

        return next;
      }
    );
  }

  function restoreHiddenRecentJobs() {
    if (!user) {
      return;
    }

    window.localStorage.removeItem(
      `${HIDDEN_RECENT_JOBS_KEY}:${user.uid}`
    );

    setHiddenRecentJobIds([]);
  }

  // BULK_HIDE_FAILED_JOBS_V1
  function hideAllFailedRecentJobs() {
    if (!user) {
      return;
    }

    const failedIds =
      recentJobs
        .filter((job) =>
          [
            "failed",
            "canceled",
            "submission_unknown",
            "ready_for_provider",
          ].includes(
            job.status || ""
          )
        )
        .map((job) => job.id);

    if (failedIds.length === 0) {
      return;
    }

    setHiddenRecentJobIds(
      (current) => {
        const next =
          Array.from(
            new Set([
              ...current,
              ...failedIds,
            ])
          );

        window.localStorage.setItem(
          `${HIDDEN_RECENT_JOBS_KEY}:${user.uid}`,
          JSON.stringify(next)
        );

        return next;
      }
    );

    setRecentJobsVisibleCount(6);
  }

  const loadRecentJobs =
    useCallback(
      async () => {
        if (!user) {
          setRecentJobs([]);
          return;
        }

        setRecentJobsLoading(true);
        setRecentJobsError(null);

        try {
          const token =
            await user.getIdToken();

          const response =
            await fetch(
              "/api/owner/ai-video/jobs",
              {
                headers: {
                  Authorization:
                    `Bearer ${token}`,
                },
                cache:
                  "no-store",
              }
            );

          const data =
            (await response.json()) as {
              success?: boolean;
              jobs?: RecentJob[];
              error?: string;
            };

          if (
            !response.ok ||
            !data.success
          ) {
            throw new Error(
              data.error ||
                "Recent AI video jobs could not be loaded."
            );
          }

          setRecentJobs(
            Array.isArray(data.jobs)
              ? data.jobs
              : []
          );
        } catch (error) {
          setRecentJobsError(
            error instanceof Error
              ? error.message
              : "Recent AI video jobs could not be loaded."
          );
        } finally {
          setRecentJobsLoading(false);
        }
      },
      [user]
    );

  useEffect(() => {
    if (!user) {
      return;
    }

    void loadRecentJobs();
  }, [
    user,
    loadRecentJobs,
  ]);

  const selectedPack =
    useMemo(
      () =>
        packs.find(
          (pack) =>
            pack.id ===
            selectedPackId
        ) || null,
      [
        packs,
        selectedPackId,
      ]
    );

  const selectedCreditCost =
    isOwner
      ? 0
      : creditCost(duration);

  const hasEnoughCredits =
    isOwner ||
    (
      typeof creditBalance ===
        "number" &&
      creditBalance >=
        selectedCreditCost
    );

  const loadCredits =
    useCallback(
      async () => {
        if (!user) {
          return;
        }

        setCreditsLoading(true);
        setCreditError(null);

        try {
          const token =
            await user.getIdToken();

          const response =
            await fetch(
              "/api/ai-video/credits/payment",
              {
                headers: {
                  Authorization:
                    `Bearer ${token}`,
                },
                cache:
                  "no-store",
              }
            );

          const data =
            (await response.json()) as {
              success?: boolean;
              balance?: number;
              packs?: CreditPack[];
              error?: string;
            };

          if (
            !response.ok ||
            !data.success
          ) {
            throw new Error(
              data.error ||
                "AI Video credits could not be loaded."
            );
          }

          setCreditBalance(
            typeof data.balance ===
              "number"
              ? data.balance
              : 0
          );

          const loadedPacks =
            Array.isArray(
              data.packs
            )
              ? data.packs
              : [];

          setPacks(
            loadedPacks
          );

          setSelectedPackId(
            (current) =>
              current ||
              loadedPacks[0]
                ?.id ||
              null
          );
        } catch (error) {
          setCreditBalance(
            null
          );

          setCreditError(
            error instanceof Error
              ? error.message
              : "AI Video credits could not be loaded."
          );
        } finally {
          setCreditsLoading(
            false
          );
        }
      },
      [user]
    );

  useEffect(() => {
    if (!user) {
      return;
    }

    void loadCredits();
  }, [
    user,
    loadCredits,
  ]);

  async function createCreditOrder() {
    if (
      !user ||
      !selectedPack
    ) {
      throw new Error(
        "Choose an AI Video credit pack."
      );
    }

    setPaymentMessage(
      "Opening secure PayPal checkout..."
    );

    setCreditError(null);

    const token =
      await user.getIdToken();

    const response =
      await fetch(
        "/api/ai-video/credits/payment",
        {
          method: "POST",
          headers: {
            Authorization:
              `Bearer ${token}`,
            "Content-Type":
              "application/json",
          },
          body:
            JSON.stringify({
              action:
                "create",
              packId:
                selectedPack.id,
            }),
        }
      );

    const data =
      (await response.json()) as {
        success?: boolean;
        orderId?: string;
        error?: string;
      };

    if (
      !response.ok ||
      !data.success ||
      !data.orderId
    ) {
      throw new Error(
        data.error ||
          "PayPal credit order could not be created."
      );
    }

    return data.orderId;
  }

  async function captureCreditOrder(
    orderId: string
  ) {
    if (!user) {
      throw new Error(
        "Sign in again before completing payment."
      );
    }

    setPaymentMessage(
      "Confirming payment and adding credits..."
    );

    const token =
      await user.getIdToken();

    const response =
      await fetch(
        "/api/ai-video/credits/payment",
        {
          method: "POST",
          headers: {
            Authorization:
              `Bearer ${token}`,
            "Content-Type":
              "application/json",
          },
          body:
            JSON.stringify({
              action:
                "capture",
              orderId,
            }),
        }
      );

    const data =
      (await response.json()) as {
        success?: boolean;
        balance?: number;
        creditsGranted?: number;
        alreadyGranted?: boolean;
        message?: string;
        error?: string;
      };

    if (
      !response.ok ||
      !data.success
    ) {
      throw new Error(
        data.error ||
          "AI Video credits could not be added."
      );
    }

    if (
      typeof data.balance ===
      "number"
    ) {
      setCreditBalance(
        data.balance
      );
    } else {
      await loadCredits();
    }

    setPaymentMessage(
      data.message ||
        "AI Video credits added successfully."
    );
  }

  async function pollRunwayJob(
    jobId: string,
    token: string
  ) {
    for (
      let attempt = 0;
      attempt < 120;
      attempt += 1
    ) {
      await new Promise(
        (resolve) =>
          window.setTimeout(
            resolve,
            3000
          )
      );

      const response =
        await fetch(
          `/api/owner/ai-video/runway?jobId=${encodeURIComponent(
            jobId
          )}`,
          {
            headers: {
              Authorization:
                `Bearer ${token}`,
            },
            cache:
              "no-store",
          }
        );

      const data =
        (await response.json()) as {
          success?: boolean;
          status?: string;
          progress?: number;
          outputUrl?:
            | string
            | null;
          message?: string;
          error?: string;
        };

      if (
        typeof data.progress ===
        "number"
      ) {
        setProgress(
          data.progress
        );
      }

      if (
        data.status ===
          "completed" &&
        data.outputUrl
      ) {
        setOutputUrl(
          data.outputUrl
        );

        if (user) {
          window.localStorage.setItem(
            `${AI_VIDEO_LAST_OUTPUT_KEY}:${user.uid}`,
            data.outputUrl
          );

          window.localStorage.setItem(
            `${AI_VIDEO_LAST_JOB_KEY}:${user.uid}`,
            jobId
          );
        }

        setProgress(100);

        setGenerationMessage(
          "AI video generation completed."
        );

        
        window.localStorage.removeItem(
          AI_VIDEO_ACTIVE_JOB_KEY
        );

        return;
      }

      if (
        data.status ===
          "failed" ||
        data.status ===
          "canceled"
      ) {
        
        window.localStorage.removeItem(
          AI_VIDEO_ACTIVE_JOB_KEY
        );

        throw new Error(
          data.error ||
            "AI video generation did not complete."
        );
      }

      if (
        !response.ok &&
        !data.success
      ) {
        throw new Error(
          data.error ||
            "AI Video generation status could not be checked."
        );
      }

      setGenerationMessage(
        data.message ||
          "AI video is generating..."
      );
    }

    throw new Error(
      "The AI video is still processing. Refresh later to check the job."
    );
  }

  useEffect(() => {
    if (!user) {
      return;
    }

    const recoveryUser = user;

    const savedJobId =
      window.localStorage
        .getItem(
          AI_VIDEO_ACTIVE_JOB_KEY
        )
        ?.trim() || "";

    if (!savedJobId) {
      return;
    }

    let cancelled = false;

    async function recoverActiveJob() {
      try {
        setCurrentJobId(
          savedJobId
        );

        setCreating(true);
        setGenerationError(null);
        setProgress(25);

        setGenerationMessage(
          "Recovering your unfinished AI video..."
        );

        const token =
          await recoveryUser.getIdToken();

        if (cancelled) {
          return;
        }

        await pollRunwayJob(
          savedJobId,
          token
        );

        if (!cancelled) {
          await loadCredits();
        }
      } catch (error) {
        if (!cancelled) {
          const message =
            error instanceof Error
              ? error.message
              : "AI video job recovery failed.";

          const missingRunwayTask =
            message
              .toLowerCase()
              .includes(
                "runway task id is missing"
              );

          if (missingRunwayTask) {
            window.localStorage.removeItem(
              AI_VIDEO_ACTIVE_JOB_KEY
            );

            setCurrentJobId(null);
            setProgress(0);

            setGenerationError(null);

            setGenerationMessage(
              "Previous unfinished generation did not reach Runway. Please generate again."
            );
          } else {
            setGenerationError(
              message
            );
          }
        }
      } finally {
        if (!cancelled) {
          setCreating(false);
        }
      }
    }

    void recoverActiveJob();

    return () => {
      cancelled = true;
    };
  }, [
    user,
    loadCredits,
  ]);
  async function handleGenerate() {
    if (
      !user ||
      creating
    ) {
      return;
    }

    const cleanPrompt =
      prompt.trim();

    if (!cleanPrompt) {
      setGenerationError(
        "Enter a generation prompt."
      );
      return;
    }

    if (
      (
        generationMode ===
          "image" ||
        generationMode ===
          "music"
      ) &&
      !imageFile
    ) {
      setGenerationError(
        "Choose an image or album cover first."
      );
      return;
    }

    if (
      generationMode ===
        "music" &&
      !audioFile
    ) {
      setGenerationError(
        "Choose a song or audio file first."
      );
      return;
    }

    if (!hasEnoughCredits) {
      setGenerationError(
        `You need ${selectedCreditCost} AI Video credit${
          selectedCreditCost ===
          1
            ? ""
            : "s"
        } for this generation.`
      );
      return;
    }

    setCreating(true);
    setGenerationError(
      null
    );
    setOutputUrl(null);

    window.localStorage.removeItem(
      `${AI_VIDEO_LAST_OUTPUT_KEY}:${user.uid}`
    );

    window.localStorage.removeItem(
      `${AI_VIDEO_LAST_JOB_KEY}:${user.uid}`
    );

    window.localStorage.removeItem(
      `${AI_VIDEO_SAVED_MEDIA_KEY}:${user.uid}`
    );

    setSavedVideoMediaId(null);
    setSaveVideoMessage(null);
    setSaveVideoError(null);

    setCurrentJobId(null);
    setProgress(0);

    try {
      const token =
        await user.getIdToken();

      setGenerationMessage(
        "Creating your AI video job..."
      );

      const jobResponse =
        await fetch(
          "/api/owner/ai-video/jobs",
          {
            method: "POST",
            headers: {
              Authorization:
                `Bearer ${token}`,
              "Content-Type":
                "application/json",
            },
            body:
              JSON.stringify({
                mode:
                  generationMode,
                prompt:
                  cleanPrompt,
                aspectRatio,
                duration:
                  Number(
                    duration
                  ),
                imageName:
                  (
                    generationMode ===
                      "image" ||
                    generationMode ===
                      "music"
                  )
                    ? imageFile
                        ?.name ||
                      null
                    : null,
                audioName:
                  generationMode ===
                    "music"
                    ? audioFile
                        ?.name ||
                      null
                    : null,
              }),
          }
        );

      const jobData =
        (await jobResponse.json()) as {
          success?: boolean;
          job?: {
            id?: string;
          };
          error?: string;
        };

      if (
        !jobResponse.ok ||
        !jobData.success ||
        !jobData.job?.id
      ) {
        throw new Error(
          jobData.error ||
            "AI video job could not be created."
        );
      }

      const jobId =
        jobData.job.id;

      setCurrentJobId(
        jobId
      );

      
      window.localStorage.setItem(
        AI_VIDEO_ACTIVE_JOB_KEY,
        jobId
      );

      if (
        generationMode ===
          "image" ||
        generationMode ===
          "music"
      ) {
        if (!imageFile) {
          throw new Error(
            "Choose an image or album cover first."
          );
        }

        setGenerationMessage(
          "Uploading source image..."
        );

        const imageFormData =
          new FormData();

        imageFormData.append(
          "jobId",
          jobId
        );

        imageFormData.append(
          "image",
          imageFile
        );

        const imageResponse =
          await fetch(
            "/api/owner/ai-video/source-image",
            {
              method: "POST",
              headers: {
                Authorization:
                  `Bearer ${token}`,
              },
              body:
                imageFormData,
            }
          );

        const imageData =
          (await imageResponse.json()) as {
            success?: boolean;
            error?: string;
          };

        if (
          !imageResponse.ok ||
          !imageData.success
        ) {
          throw new Error(
            imageData.error ||
              "Source image could not be uploaded."
          );
        }
      }

      let uploadedAudioMediaId:
        string | null = null;

      if (
        generationMode ===
          "music"
      ) {
        if (!audioFile) {
          throw new Error(
            "Choose a song or audio file first."
          );
        }

        setGenerationMessage(
          "Uploading song..."
        );

        const audioFormData =
          new FormData();

        audioFormData.append(
          "jobId",
          jobId
        );

        audioFormData.append(
          "audio",
          audioFile
        );

        const audioResponse =
          await fetch(
            "/api/owner/ai-video/source-audio",
            {
              method: "POST",
              headers: {
                Authorization:
                  `Bearer ${token}`,
              },
              body:
                audioFormData,
            }
          );

        const audioData =
          (await audioResponse.json()) as {
            success?: boolean;
            audioMediaId?: string;
            error?: string;
          };

        if (
          !audioResponse.ok ||
          !audioData.success ||
          !audioData.audioMediaId
        ) {
          throw new Error(
            audioData.error ||
              "Song could not be uploaded."
          );
        }

        uploadedAudioMediaId =
          audioData.audioMediaId;
      }

      setGenerationMessage(
        generationMode ===
          "music"
          ? "Creating Song + Cover visual..."
          : generationMode ===
              "image"
            ? "Sending Image to Video job to Runway..."
            : "Sending your job to Runway..."
      );

      const runwayResponse =
        await fetch(
          "/api/owner/ai-video/runway",
          {
            method: "POST",
            headers: {
              Authorization:
                `Bearer ${token}`,
              "Content-Type":
                "application/json",
            },
            body:
              JSON.stringify({
                jobId,
              }),
          }
        );

      const runwayData =
        (await runwayResponse.json()) as {
          success?: boolean;
          status?: string;
          progress?: number;
          error?: string;
        };

      if (
        !runwayResponse.ok ||
        !runwayData.success
      ) {
        throw new Error(
          runwayData.error ||
            "Runway generation could not be started."
        );
      }

      if (
        typeof runwayData.progress ===
        "number"
      ) {
        setProgress(
          runwayData.progress
        );
      }

      setGenerationMessage(
        "Runway generation started."
      );

      await loadCredits();

      await pollRunwayJob(
        jobId,
        token
      );

      if (
        generationMode ===
          "music"
      ) {
        if (
          !uploadedAudioMediaId
        ) {
          throw new Error(
            "Song upload did not return a Media ID."
          );
        }

        setGenerationMessage(
          "Adding song to completed AI video..."
        );

        const musicResponse =
          await fetch(
            "/api/owner/ai-video/add-music",
            {
              method: "POST",
              headers: {
                Authorization:
                  `Bearer ${token}`,
                "Content-Type":
                  "application/json",
              },
              body:
                JSON.stringify({
                  jobId,
                  audioMediaId:
                    uploadedAudioMediaId,
                  volume: 1,
                  musicStart: 0,
                  loopMusic: true,
                }),
            }
          );

        const musicData =
          (await musicResponse.json()) as {
            success?: boolean;
            mediaId?: string;
            previewUrl?: string;
            error?: string;
          };

        if (
          !musicResponse.ok ||
          !musicData.success ||
          !musicData.mediaId
        ) {
          throw new Error(
            musicData.error ||
              "Song could not be added to the AI video."
          );
        }

        if (
          musicData.previewUrl
        ) {
          setOutputUrl(
            musicData.previewUrl
          );
        }

        setSavedVideoMediaId(
          musicData.mediaId
        );

        window.localStorage.setItem(
          `${AI_VIDEO_SAVED_MEDIA_KEY}:${user.uid}`,
          musicData.mediaId
        );

        setSaveVideoMessage(
          "Song + Cover music video saved permanently to Video Manager."
        );

        setGenerationMessage(
          "Song + Cover AI music video completed."
        );
      }

      await loadCredits();
    } catch (error) {
      window.localStorage.removeItem(
        AI_VIDEO_ACTIVE_JOB_KEY
      );

      setGenerationError(
        error instanceof Error
          ? error.message
          : "AI video generation failed."
      );
    } finally {
      setCreating(false);
    }
  }

  async function handleSaveToVideoManager() {
    if (
      !user ||
      !currentJobId ||
      savingToVideoManager
    ) {
      return;
    }

    setSavingToVideoManager(true);
    setSaveVideoError(null);
    setSaveVideoMessage(null);

    try {
      const token =
        await user.getIdToken();

      const response =
        await fetch(
          "/api/owner/ai-video/save-to-video-manager",
          {
            method: "POST",
            headers: {
              Authorization:
                `Bearer ${token}`,
              "Content-Type":
                "application/json",
            },
            body:
              JSON.stringify({
                jobId:
                  currentJobId,
              }),
          }
        );

      const data =
        (await response.json()) as {
          success?: boolean;
          alreadySaved?: boolean;
          mediaId?: string;
          storagePath?: string | null;
          message?: string;
          error?: string;
        };

      if (
        !response.ok ||
        !data.success ||
        !data.mediaId
      ) {
        throw new Error(
          data.error ||
            "AI video could not be saved to Video Manager."
        );
      }

      setSavedVideoMediaId(
        data.mediaId
      );

      window.localStorage.setItem(
        `${AI_VIDEO_SAVED_MEDIA_KEY}:${user.uid}`,
        data.mediaId
      );

      setSaveVideoMessage(
        data.alreadySaved
          ? "Video is already saved permanently in Video Manager."
          : "Video saved permanently to Video Manager."
      );
    } catch (error) {
      setSaveVideoError(
        error instanceof Error
          ? error.message
          : "AI video could not be saved to Video Manager."
      );
    } finally {
      setSavingToVideoManager(false);
    }
  }

  if (loading) {
    return (
      <main className="min-h-screen bg-[#070710] px-6 py-16 text-white">
        <div className="mx-auto max-w-6xl">
          <p className="text-white/60">
            Loading AI Video Generator...
          </p>
        </div>
      </main>
    );
  }

  if (!user) {
    return (
      <main className="min-h-screen bg-[#070710] px-6 py-16 text-white">
        <div className="mx-auto max-w-2xl rounded-3xl border border-violet-400/20 bg-violet-500/5 p-8">
          <p className="text-xs font-black uppercase tracking-[0.22em] text-violet-300">
            SOLO BEATS AI VIDEO
          </p>

          <h1 className="mt-3 text-3xl font-black">
            Sign in to continue
          </h1>

          <p className="mt-3 leading-7 text-white/55">
            AI Video generation is available to active SOLO BEATS PREMIUM members.
          </p>

          <Link
            href="/account"
            className="mt-6 inline-flex rounded-2xl bg-violet-500 px-6 py-3 font-black text-white"
          >
            Sign In
          </Link>
        </div>
      </main>
    );
  }

  if (
    creditError &&
    creditBalance === null
  ) {
    return (
      <main className="min-h-screen bg-[#070710] px-6 py-16 text-white">
        <div className="mx-auto max-w-2xl rounded-3xl border border-red-400/20 bg-red-500/5 p-8">
          <p className="text-xs font-black uppercase tracking-[0.22em] text-red-300">
            Premium Access Required
          </p>

          <h1 className="mt-3 text-3xl font-black">
            AI Video Generator
          </h1>

          <p className="mt-4 leading-7 text-white/60">
            {creditError}
          </p>

          <Link
            href="/premium"
            className="mt-6 inline-flex rounded-2xl bg-violet-500 px-6 py-3 font-black text-white"
          >
            View Premium Membership
          </Link>
        </div>
      </main>
    );
  }

  return (
    <main className="min-h-screen bg-[#070710] px-4 py-10 text-white sm:px-6">
      <div className="mx-auto max-w-6xl">
        <div className="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <p className="text-xs font-black uppercase tracking-[0.24em] text-violet-300">
              SOLO BEATS PREMIUM
            </p>

            <h1 className="mt-3 text-4xl font-black sm:text-5xl">
              AI Video Generator
            </h1>

            <p className="mt-4 max-w-2xl leading-7 text-white/55">
              Turn your ideas into AI video clips. Premium membership is required and each generation uses AI Video credits.
            </p>
          </div>

          <div className="rounded-3xl border border-emerald-400/20 bg-emerald-500/10 px-6 py-5">
            <p className="text-xs font-black uppercase tracking-[0.2em] text-emerald-300">
              Credit Balance
            </p>

            <p className="mt-2 text-4xl font-black">
              {creditsLoading &&
              creditBalance === null
                ? "..."
                : creditBalance ??
                  0}
            </p>

            <p className="mt-1 text-xs text-white/45">
              AI Video Credits
            </p>
          </div>
        </div>

        <section className="mt-8 rounded-3xl border border-white/10 bg-[#10101b] p-6">
          <div>
            <p className="text-xs font-black uppercase tracking-[0.22em] text-fuchsia-300">
              Buy Credits
            </p>

            <h2 className="mt-2 text-2xl font-black">
              Choose a credit pack
            </h2>

            <p className="mt-2 text-sm leading-6 text-white/50">
              Credit-pack pricing includes AI provider costs, payment processing, platform overhead, and SOLO BEATS service margin.
            </p>
          </div>

          <div className="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {packs.map(
              (pack) => {
                const selected =
                  selectedPackId ===
                  pack.id;

                return (
                  <button
                    key={
                      pack.id
                    }
                    type="button"
                    onClick={() =>
                      setSelectedPackId(
                        pack.id
                      )
                    }
                    className={`rounded-2xl border p-5 text-left transition ${
                      selected
                        ? "border-violet-400 bg-violet-500/15"
                        : "border-white/10 bg-white/[0.035] hover:bg-white/[0.06]"
                    }`}
                  >
                    <p className="text-2xl font-black">
                      {
                        pack.credits
                      }{" "}
                      Credits
                    </p>

                    <p className="mt-2 text-xl font-black text-emerald-300">
                      $
                      {pack.price.toFixed(
                        2
                      )}
                    </p>

                    <p className="mt-2 text-xs text-white/40">
                      $
                      {(
                        pack.price /
                        pack.credits
                      ).toFixed(
                        2
                      )}{" "}
                      per credit
                    </p>
                  </button>
                );
              }
            )}
          </div>

          {selectedPack ? (
            <div className="mt-6 max-w-md rounded-2xl bg-white p-4">
              {paypalClientId ? (
                <PayPalScriptProvider
                  options={{
                    clientId:
                      paypalClientId,
                    currency:
                      "USD",
                    intent:
                      "capture",
                  }}
                >
                  <PayPalButtons
                    forceReRender={[
                      selectedPack.id,
                      selectedPack.price,
                    ]}
                    style={{
                      layout:
                        "vertical",
                      shape:
                        "rect",
                      label:
                        "pay",
                    }}
                    createOrder={
                      async () =>
                        createCreditOrder()
                    }
                    onApprove={
                      async (
                        data
                      ) => {
                        try {
                          if (
                            !data.orderID
                          ) {
                            throw new Error(
                              "PayPal did not return a valid order."
                            );
                          }

                          await captureCreditOrder(
                            data.orderID
                          );
                        } catch (
                          error
                        ) {
                          setPaymentMessage(
                            null
                          );

                          setCreditError(
                            error instanceof
                              Error
                              ? error.message
                              : "AI Video credit payment failed."
                          );
                        }
                      }
                    }
                    onCancel={() => {
                      setPaymentMessage(
                        null
                      );

                      setCreditError(
                        "PayPal checkout was cancelled. No credits were purchased."
                      );
                    }}
                    onError={(
                      error
                    ) => {
                      console.error(
                        "AI Video PayPal error:",
                        error
                      );

                      setPaymentMessage(
                        null
                      );

                      setCreditError(
                        "PayPal encountered an error. Please try again."
                      );
                    }}
                  />
                </PayPalScriptProvider>
              ) : (
                <p className="p-4 text-center font-black text-red-700">
                  PayPal Client ID is missing.
                </p>
              )}
            </div>
          ) : null}

          {paymentMessage ? (
            <p className="mt-4 rounded-2xl border border-emerald-400/20 bg-emerald-500/10 p-4 text-sm font-bold text-emerald-200">
              {paymentMessage}
            </p>
          ) : null}

          {creditError &&
          creditBalance !==
            null ? (
            <p className="mt-4 rounded-2xl border border-red-400/20 bg-red-500/10 p-4 text-sm font-bold text-red-200">
              {creditError}
            </p>
          ) : null}
        </section>

        <div className="mt-8 grid gap-6 lg:grid-cols-[1.05fr_0.95fr]">
          <section className="rounded-3xl border border-white/10 bg-[#10101b] p-6">
            <p className="text-xs font-black uppercase tracking-[0.22em] text-violet-300">
              {generationMode ===
              "music"
                ? "Song + Cover"
                : generationMode ===
                    "image"
                  ? "Image to Video"
                  : "Text to Video"}
            </p>

            <h2 className="mt-2 text-2xl font-black">
              Create your video
            </h2>

            <div className="mt-6 grid gap-3 sm:grid-cols-3">
              <button
                type="button"
                onClick={() => {
                  if (!creating) {
                    setGenerationMode(
                      "text"
                    );
                  }
                }}
                className={`rounded-2xl border px-4 py-3 text-sm font-black transition ${
                  generationMode ===
                  "text"
                    ? "border-violet-400/50 bg-violet-500/20 text-violet-200"
                    : "border-white/10 bg-black/20 text-white/55"
                }`}
              >
                Text to Video
              </button>

              <button
                type="button"
                onClick={() => {
                  if (!creating) {
                    setGenerationMode(
                      "image"
                    );
                  }
                }}
                className={`rounded-2xl border px-4 py-3 text-sm font-black transition ${
                  generationMode ===
                  "image"
                    ? "border-cyan-400/50 bg-cyan-500/20 text-cyan-200"
                    : "border-white/10 bg-black/20 text-white/55"
                }`}
              >
                Image / Album Cover
              </button>

              <button
                type="button"
                onClick={() => {
                  if (!creating) {
                    setGenerationMode(
                      "music"
                    );
                  }
                }}
                className={`rounded-2xl border px-4 py-3 text-sm font-black transition ${
                  generationMode ===
                  "music"
                    ? "border-fuchsia-400/50 bg-fuchsia-500/20 text-fuchsia-200"
                    : "border-white/10 bg-black/20 text-white/55"
                }`}
              >
                Song + Cover
              </button>
            </div>

            {(
              generationMode ===
                "image" ||
              generationMode ===
                "music"
            ) ? (
              <label className="mt-5 block rounded-2xl border border-cyan-400/20 bg-cyan-500/5 p-4">
                <span className="text-sm font-black">
                  Source Image / Album Cover
                </span>

                <input
                  type="file"
                  accept="image/*"
                  disabled={
                    creating
                  }
                  onChange={(
                    event
                  ) => {
                    const file =
                      event.target
                        .files?.[0] ||
                      null;

                    setImageFile(
                      file
                    );
                  }}
                  className="mt-3 block w-full text-sm text-white/60 file:mr-4 file:rounded-xl file:border-0 file:bg-cyan-500/20 file:px-4 file:py-3 file:font-black file:text-cyan-200"
                />

                {imageFile ? (
                  <p className="mt-3 break-all text-xs text-emerald-300">
                    Selected: {
                      imageFile.name
                    }
                  </p>
                ) : (
                  <p className="mt-3 text-xs text-white/40">
                    Choose a JPG, PNG, WEBP, or other supported image.
                  </p>
                )}
              </label>
            ) : null}

            {generationMode ===
            "music" ? (
              <label className="mt-5 block rounded-2xl border border-fuchsia-400/20 bg-fuchsia-500/5 p-4">
                <span className="text-sm font-black">
                  Song / Audio
                </span>

                <input
                  type="file"
                  accept="audio/*,.wav,.mp3,.m4a,.aac"
                  disabled={
                    creating
                  }
                  onChange={(
                    event
                  ) => {
                    const file =
                      event.target
                        .files?.[0] ||
                      null;

                    setAudioFile(
                      file
                    );
                  }}
                  className="mt-3 block w-full text-sm text-white/60 file:mr-4 file:rounded-xl file:border-0 file:bg-fuchsia-500/20 file:px-4 file:py-3 file:font-black file:text-fuchsia-200"
                />

                {audioFile ? (
                  <p className="mt-3 break-all text-xs text-emerald-300">
                    Selected song: {
                      audioFile.name
                    }
                  </p>
                ) : (
                  <p className="mt-3 text-xs text-white/40">
                    Choose an MP3, WAV, M4A, or AAC song.
                  </p>
                )}
              </label>
            ) : null}

            <label className="mt-6 block">
              <span className="text-sm font-black">
                Prompt
              </span>

              <textarea
                value={
                  prompt
                }
                onChange={(
                  event
                ) =>
                  setPrompt(
                    event
                      .target
                      .value
                  )
                }
                rows={7}
                placeholder="Describe the video you want to create..."
                className="mt-3 w-full rounded-2xl border border-white/10 bg-[#080812] px-4 py-4 text-sm leading-6 text-white outline-none focus:border-violet-400/50"
              />
            </label>

            <div className="mt-5 grid gap-4 sm:grid-cols-2">
              <label>
                <span className="text-sm font-black">
                  Aspect Ratio
                </span>

                <select
                  value={
                    aspectRatio
                  }
                  onChange={(
                    event
                  ) =>
                    setAspectRatio(
                      event
                        .target
                        .value as AspectRatio
                    )
                  }
                  className="mt-3 w-full rounded-xl border border-white/10 bg-[#080812] px-4 py-3 text-white outline-none"
                >
                  <option value="16:9">
                    16:9 Landscape
                  </option>

                  <option value="9:16">
                    9:16 Vertical
                  </option>
                </select>
              </label>

              <label>
                <span className="text-sm font-black">
                  Duration
                </span>

                <select
                  value={
                    duration
                  }
                  onChange={(
                    event
                  ) =>
                    setDuration(
                      event
                        .target
                        .value as Duration
                    )
                  }
                  className="mt-3 w-full rounded-xl border border-white/10 bg-[#080812] px-4 py-3 text-white outline-none"
                >
                  <option value="5">
                    5 seconds — 1 credit
                  </option>

                  <option value="10">
                    10 seconds — 2 credits
                  </option>
                </select>
              </label>
            </div>

            <div className="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-white/10 bg-black/20 p-4">
              <div>
                <p className="text-xs font-black uppercase tracking-[0.18em] text-white/40">
                  Generation Cost
                </p>

                <p className="mt-1 text-xl font-black">
                  {
                    selectedCreditCost
                  }{" "}
                  Credit
                  {selectedCreditCost ===
                  1
                    ? ""
                    : "s"}
                </p>
              </div>

              <div className="text-right">
                <p className="text-xs text-white/40">
                  Balance after generation
                </p>

                <p className="mt-1 font-black text-emerald-300">
                  {typeof creditBalance ===
                  "number"
                    ? progress === 100 &&
                      outputUrl
                      ? creditBalance
                      : Math.max(
                          0,
                          creditBalance -
                            selectedCreditCost
                        )
                    : "--"}
                </p>
              </div>
            </div>

            {!hasEnoughCredits ? (
              <p className="mt-4 rounded-2xl border border-amber-400/20 bg-amber-500/10 p-4 text-sm font-bold text-amber-200">
                You need more AI Video credits before generating this clip.
              </p>
            ) : null}

            <button
              type="button"
              onClick={
                handleGenerate
              }
              disabled={
                creating ||
                !hasEnoughCredits ||
                (
                  (
                    generationMode ===
                      "image" ||
                    generationMode ===
                      "music"
                  ) &&
                  !imageFile
                ) ||
                (
                  generationMode ===
                    "music" &&
                  !audioFile
                )
              }
              className="mt-6 w-full rounded-2xl bg-gradient-to-r from-violet-500 to-fuchsia-500 px-5 py-4 font-black text-white shadow-lg shadow-violet-950/30 disabled:cursor-not-allowed disabled:opacity-40"
            >
              {creating
                ? "Generating..."
                : `Generate Video — ${selectedCreditCost} Credit${
                    selectedCreditCost ===
                    1
                      ? ""
                      : "s"
                  }`}
            </button>

            {generationError ? (
              <p className="mt-4 rounded-2xl border border-red-400/20 bg-red-500/10 p-4 text-sm font-bold text-red-200">
                {
                  generationError
                }
              </p>
            ) : null}
          </section>

          <section className="rounded-3xl border border-cyan-400/20 bg-cyan-500/5 p-6">
            <p className="text-xs font-black uppercase tracking-[0.22em] text-cyan-300">
              Generation Status
            </p>

            <div className="mt-5 rounded-2xl border border-white/10 bg-[#080812] p-5">
              <div className="flex items-center justify-between gap-4">
                <span className="font-black">
                  Progress
                </span>

                <span className="text-sm font-black text-cyan-300">
                  {progress}%
                </span>
              </div>

              <div className="mt-4 h-2 overflow-hidden rounded-full bg-white/10">
                <div
                  className="h-full rounded-full bg-white/70 transition-all"
                  style={{
                    width:
                      `${Math.min(
                        100,
                        Math.max(
                          0,
                          progress
                        )
                      )}%`,
                  }}
                />
              </div>

              <p className="mt-4 text-sm leading-6 text-white/55">
                {
                  generationMessage
                }
              </p>

              {currentJobId ? (
                <div className="mt-4 rounded-xl border border-violet-400/20 bg-violet-500/10 px-4 py-3">
                  <p className="text-xs font-black uppercase tracking-[0.16em] text-violet-300">
                    Job ID
                  </p>

                  <p className="mt-1 break-all text-xs text-white/60">
                    {
                      currentJobId
                    }
                  </p>
                </div>
              ) : null}
            </div>

            <div className="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-black/30">
              {outputUrl ? (
                <>
                  <video
                    src={
                      outputUrl
                    }
                    controls
                    playsInline
                    className="w-full"
                  />

                  <div className="p-4">
                    <a
                      href={
                        outputUrl
                      }
                      target="_blank"
                      rel="noreferrer"
                      className="flex w-full items-center justify-center rounded-xl bg-white px-4 py-3 text-sm font-black text-black"
                    >
                      Open / Download Video
                    </a>
                  </div>

                  {currentJobId ? (
                    <div className="border-t border-white/10 p-4">
                      <button
                        type="button"
                        onClick={
                          handleSaveToVideoManager
                        }
                        disabled={
                          savingToVideoManager ||
                          Boolean(
                            savedVideoMediaId
                          )
                        }
                        className="flex w-full items-center justify-center rounded-xl bg-cyan-400 px-4 py-3 text-sm font-black text-black disabled:cursor-not-allowed disabled:opacity-50"
                      >
                        {
                          savedVideoMediaId
                            ? "Saved to Video Manager"
                            : savingToVideoManager
                              ? "Saving Permanently..."
                              : "Save to Video Manager"
                        }
                      </button>

                      {saveVideoMessage ? (
                        <p className="mt-3 rounded-xl border border-emerald-400/20 bg-emerald-500/10 p-3 text-sm font-bold text-emerald-200">
                          {
                            saveVideoMessage
                          }
                        </p>
                      ) : null}

                      {saveVideoError ? (
                        <p className="mt-3 rounded-xl border border-red-400/20 bg-red-500/10 p-3 text-sm font-bold text-red-200">
                          {
                            saveVideoError
                          }
                        </p>
                      ) : null}

                      {savedVideoMediaId ? (
                        <p className="mt-3 break-all text-xs text-white/45">
                          Media ID: {
                            savedVideoMediaId
                          }
                        </p>
                      ) : null}
                    </div>
                  ) : null}
                </>
              ) : (
                <div className="grid min-h-[300px] place-items-center p-8 text-center">
                  <div>
                    <p className="text-xl font-black text-white/70">
                      Generated video will appear here
                    </p>

                    <p className="mt-2 text-sm leading-6 text-white/35">
                      Create a generation job to start your AI video.
                    </p>
                  </div>
                </div>
              )}
            </div>
          </section>
        </div>


        {/* RECENT_JOBS_UI_V2 */}
        <section className="mt-8 rounded-3xl border border-violet-400/20 bg-violet-500/5 p-6">
          <div className="flex flex-wrap items-center justify-between gap-4">
            <div>
              <p className="text-xs font-black uppercase tracking-[0.22em] text-violet-300">
                Generation History
              </p>

              <h2 className="mt-2 text-2xl font-black">
                Recent Jobs
              </h2>
            </div>

            <button
              type="button"
              onClick={() =>
                void loadRecentJobs()
              }
              disabled={
                recentJobsLoading
              }
              className="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-black text-white/70 disabled:opacity-40"
            >
              {recentJobsLoading
                ? "Refreshing..."
                : "Refresh"}
            </button>


          </div>

          <div className="mt-5 flex flex-wrap gap-2">
            {(
              [
                [
                  "all",
                  "All",
                ],
                [
                  "completed",
                  "Completed",
                ],
                [
                  "failed",
                  "Failed",
                ],
                [
                  "hidden",
                  `Hidden (${hiddenRecentJobIds.length})`,
                ],
              ] as const
            ).map(
              ([
                value,
                label,
              ]) => (
                <button
                  key={value}
                  type="button"
                  onClick={() => {
                    setRecentJobFilter(
                      value
                    );
                    setRecentJobsVisibleCount(
                      6
                    );
                  }}
                  className={`rounded-xl border px-4 py-2 text-xs font-black transition ${
                    recentJobFilter ===
                    value
                      ? "border-violet-400/40 bg-violet-500/20 text-violet-100"
                      : "border-white/10 bg-white/5 text-white/50 hover:bg-white/10"
                  }`}
                >
                  {label}
                </button>
              )
            )}
          </div>

          <div className="mt-4">
            <input
              type="search"
              value={recentJobsSearch}
              onChange={(event) => {
                setRecentJobsSearch(
                  event.target.value
                );
                setRecentJobsVisibleCount(
                  6
                );
              }}
              placeholder="Search by Job ID, prompt, mode, or status..."
              className="w-full rounded-xl border border-white/10 bg-black/20 px-4 py-3 text-sm font-bold text-white outline-none placeholder:text-white/30 focus:border-violet-400/40"
            />

            {recentJobsSearch.trim() ? (
              <p className="mt-2 text-xs font-bold text-white/35">
                {
                  searchedRecentJobs.length
                }{" "}
                matching job
                {
                  searchedRecentJobs.length ===
                  1
                    ? ""
                    : "s"
                }
              </p>
            ) : null}
          </div>

          {searchedRecentJobs.length >
          6 ? (
            <div className="mt-4 flex flex-wrap items-center gap-3">
              <button
                type="button"
                onClick={() =>
                  setRecentJobsVisibleCount(
                    (current) =>
                      current >=
                      searchedRecentJobs.length
                        ? 6
                        : Math.min(
                            current + 6,
                            searchedRecentJobs.length
                          )
                  )
                }
                className="rounded-xl border border-violet-400/30 bg-violet-500/10 px-4 py-2 text-xs font-black text-violet-100 transition hover:bg-violet-500/20"
              >
                {recentJobsVisibleCount >=
                searchedRecentJobs.length
                  ? "Show Less"
                  : `Load More (${Math.min(
                      6,
                      searchedRecentJobs.length -
                        recentJobsVisibleCount
                    )})`}
              </button>

              <span className="text-xs font-bold text-white/35">
                Showing{" "}
                {Math.min(
                  recentJobsVisibleCount,
                  searchedRecentJobs.length
                )}{" "}
                of{" "}
                {searchedRecentJobs.length}
              </span>
            </div>
          ) : null}

          {recentJobFilter ===
            "failed" &&
          filteredRecentJobs.length >
            0 ? (
            <button
              type="button"
              onClick={
                hideAllFailedRecentJobs
              }
              className="mt-3 rounded-xl border border-amber-400/20 bg-amber-500/10 px-4 py-2 text-xs font-black text-amber-200 transition hover:bg-amber-500/20"
            >
              Hide All Failed (
              {filteredRecentJobs.length})
            </button>
          ) : null}

          {recentJobFilter ===
            "hidden" &&
          hiddenRecentJobIds.length >
            0 ? (
            <button
              type="button"
              onClick={
                restoreHiddenRecentJobs
              }
              className="mt-3 rounded-xl border border-emerald-400/20 bg-emerald-500/10 px-4 py-2 text-xs font-black text-emerald-200"
            >
              Restore All Hidden
            </button>
          ) : null}

          {recentJobsError ? (
            <p className="mt-5 rounded-2xl border border-red-400/20 bg-red-500/10 p-4 text-sm font-bold text-red-200">
              {recentJobsError}
            </p>
          ) : null}

          {!recentJobsLoading &&
          !recentJobsError &&
          recentJobs.length === 0 ? (
            <div className="mt-5 rounded-2xl border border-white/10 bg-black/20 p-6 text-center text-white/50">
              No AI Video jobs yet.
            </div>
          ) : null}

          {recentJobs.length > 0 ? (
            <div className="mt-5 grid gap-4">
              {searchedRecentJobs
                .slice(
                  0,
                  recentJobsVisibleCount
                )
                .map(
                (job) => (
                  <article
                    key={job.id}
                    className="rounded-2xl border border-white/10 bg-[#080812] p-5"
                  >
                    <div className="flex flex-wrap items-start justify-between gap-4">
                      <div>
                        <div className="flex flex-wrap gap-2">
                          <span className="rounded-full bg-violet-500/10 px-3 py-1 text-xs font-black uppercase text-violet-200">
                            {job.mode ||
                              "AI Video"}
                          </span>

                          <span className="rounded-full bg-cyan-500/10 px-3 py-1 text-xs font-black uppercase text-cyan-200">
                            {job.status ||
                              "unknown"}
                          </span>
                        </div>

                        <p className="mt-3 break-all text-xs text-white/40">
                          Job ID: {job.id}
                        </p>
                      </div>

                      <div className="text-right text-xs text-white/40">
                        <p>
                          {job.duration
                            ? `${job.duration}s`
                            : "--"}
                        </p>

                        <p className="mt-1">
                          {job.aspectRatio ||
                            "--"}
                        </p>
                      </div>
                    </div>

                    {job.prompt ? (
                      <p className="mt-4 text-sm leading-6 text-white/55">
                        {job.prompt}
                      </p>
                    ) : null}

                    <div className="mt-4">
                      <div className="flex justify-between text-xs font-bold text-white/45">
                        <span>
                          Progress
                        </span>

                        <span>
                          {typeof job.progress ===
                          "number"
                            ? `${job.progress}%`
                            : "--"}
                        </span>
                      </div>

                      <div className="mt-2 h-2 overflow-hidden rounded-full bg-white/10">
                        <div
                          className="h-full rounded-full bg-white/70"
                          style={{
                            width:
                              `${Math.min(
                                100,
                                Math.max(
                                  0,
                                  typeof job.progress ===
                                    "number"
                                    ? job.progress
                                    : 0
                                )
                              )}%`,
                          }}
                        />
                      </div>
                    </div>

                    {job.providerJobId ? (
                      <p className="mt-4 break-all text-xs text-white/35">
                        Provider Job ID:{" "}
                        {job.providerJobId}
                      </p>
                    ) : null}

                    {job.error ? (
                      <p className="mt-4 rounded-xl border border-red-400/20 bg-red-500/10 p-3 text-sm font-bold text-red-200">
                        {job.error}
                      </p>
                    ) : null}

                    <div className="mt-4 flex flex-wrap items-center gap-3">
                      {recentJobFilter ===
                      "hidden" ? (
                        <button
                          type="button"
                          onClick={() =>
                            unhideRecentJob(
                              job.id
                            )
                          }
                          className="rounded-xl border border-emerald-400/20 bg-emerald-500/10 px-4 py-2 text-xs font-black text-emerald-200 hover:bg-emerald-500/20"
                        >
                          Restore Job
                        </button>
                      ) : (
                        <button
                          type="button"
                          onClick={() =>
                            hideRecentJob(
                              job.id
                            )
                          }
                          className="rounded-xl border border-amber-400/20 bg-amber-500/10 px-4 py-2 text-xs font-black text-amber-200 hover:bg-amber-500/20"
                        >
                          Hide Job
                        </button>
                      )}

                      {job.outputUrl ? (
                        <a
                          href={
                            job.outputUrl
                          }
                          target="_blank"
                          rel="noreferrer"
                          className="rounded-xl bg-white px-4 py-2 text-xs font-black text-black"
                        >
                          Open Video
                        </a>
                      ) : null}

                      {job.createdAt ? (
                        <span className="text-xs text-white/35">
                          {new Date(
                            job.createdAt
                          ).toLocaleString()}
                        </span>
                      ) : null}
                    </div>
                  </article>
                )
              )}
            </div>
          ) : null}
        </section>

        <div className="mt-8 flex flex-wrap gap-3">
          <Link
            href="/premium"
            className="rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-black text-white/70"
          >
            Premium Home
          </Link>

          <Link
            href="/account"
            className="rounded-xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-black text-white/70"
          >
            Account
          </Link>
        </div>
      </div>
    </main>
  );
}


