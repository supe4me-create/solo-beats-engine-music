"use client";

import {
  useCallback,
  useEffect,
  useState,
} from "react";

import Link from "next/link";

import {
  useAuth,
} from "../../auth/AuthContext";

const OWNER_EMAIL =
  "supe4.me@gmail.com";

type MediaItem = {
  mediaId: string;
  title: string;
  kind: string | null;
  previewUrl: string | null;
  storagePath: string | null;
  status: string;
};

type Product = {
  productId: string;
  title: string;
  description: string;
  sku: string;
  category: string;
  price: number;
  stock: number;
  shippingCharge: number;
  active: boolean;
  imageMediaId: string | null;
  imageStoragePath: string | null;
  imagePreviewUrl: string | null;
};

const blankForm = {
  productId: "",
  title: "",
  description: "",
  sku: "",
  category: "",
  price: "0.00",
  stock: "0",
  shippingCharge: "0.00",
  active: true,
  imageMediaId: "",
};

export default function ProductsPage() {
  const {
    user,
    loading,
  } = useAuth();

  const [
    products,
    setProducts,
  ] = useState<Product[]>([]);

  const [
    media,
    setMedia,
  ] = useState<MediaItem[]>([]);

  const [
    form,
    setForm,
  ] = useState(blankForm);

  const [
    busy,
    setBusy,
  ] = useState(false);

  const [
    uploadingImage,
    setUploadingImage,
  ] = useState(false);

  const [
    error,
    setError,
  ] = useState("");

  const [
    message,
    setMessage,
  ] = useState("");

  const isOwner =
    !!user &&
    user.email
      ?.toLowerCase() ===
      OWNER_EMAIL;

  const loadData =
    useCallback(
      async () => {
        if (
          !user ||
          !isOwner
        ) {
          return;
        }

        setBusy(true);
        setError("");

        try {
          const token =
            await user.getIdToken();

          const headers = {
            Authorization:
              `Bearer ${token}`,
          };

          const [
            productsResponse,
            mediaResponse,
          ] =
            await Promise.all([
              fetch(
                "/api/owner/products",
                {
                  headers,
                  cache:
                    "no-store",
                }
              ),

              fetch(
                "/api/owner/media",
                {
                  headers,
                  cache:
                    "no-store",
                }
              ),
            ]);

          const productsData =
            await productsResponse.json();

          const mediaData =
            await mediaResponse.json();

          if (
            !productsResponse.ok ||
            !productsData.success
          ) {
            throw new Error(
              productsData.error ||
                "Products could not be loaded."
            );
          }

          if (
            !mediaResponse.ok ||
            !mediaData.success
          ) {
            throw new Error(
              mediaData.error ||
                "Media Library could not be loaded."
            );
          }

          setProducts(
            Array.isArray(
              productsData.products
            )
              ? productsData.products
              : []
          );

          setMedia(
            Array.isArray(
              mediaData.media
            )
              ? mediaData.media.filter(
                  (
                    item: MediaItem
                  ) =>
                    item.kind ===
                      "image" &&
                    item.status !==
                      "deleted"
                )
              : []
          );
        } catch (error) {
          setError(
            error instanceof Error
              ? error.message
              : "Product Manager could not load."
          );
        } finally {
          setBusy(false);
        }
      },
      [
        user,
        isOwner,
      ]
    );

  useEffect(() => {
    void loadData();
  }, [loadData]);

  function updateField(
    field: keyof typeof blankForm,
    value:
      | string
      | boolean
  ) {
    setForm(
      (current) => ({
        ...current,
        [field]: value,
      })
    );
  }

  function clearForm() {
    setForm(blankForm);
    setError("");
    setMessage("");
  }

  function editProduct(
    product: Product
  ) {
    setForm({
      productId:
        product.productId,

      title:
        product.title,

      description:
        product.description,

      sku:
        product.sku,

      category:
        product.category,

      price:
        String(
          product.price
        ),

      stock:
        String(
          product.stock
        ),

      shippingCharge:
        String(
          product.shippingCharge
        ),

      active:
        product.active,

      imageMediaId:
        product.imageMediaId ||
        "",
    });

    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  async function uploadProductImage(
    file: File
  ) {
    if (!user) {
      return;
    }

    if (
      !file.type.startsWith("image/")
    ) {
      setError(
        "Please choose an image file."
      );
      return;
    }

    setUploadingImage(true);
    setError("");
    setMessage("");

    try {
      const token =
        await user.getIdToken();

      const fileInfo = {
        name: file.name,
        type: file.type,
        size: file.size,
        lastModified:
          file.lastModified,
      };

      const prepareResponse =
        await fetch(
          "/api/owner/media",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              Authorization:
                `Bearer ${token}`,
            },

            body:
              JSON.stringify({
                action: "prepare",
                file: fileInfo,
              }),
          }
        );

      const prepareData =
        await prepareResponse.json();

      if (
        !prepareResponse.ok ||
        !prepareData.success ||
        !prepareData.uploadUrl ||
        !prepareData.mediaId ||
        !prepareData.storagePath
      ) {
        throw new Error(
          prepareData.error ||
            "Image upload could not be prepared."
        );
      }

      const uploadResponse =
        await fetch(
          prepareData.uploadUrl,
          {
            method: "PUT",

            headers: {
              "Content-Type":
                file.type ||
                "application/octet-stream",
            },

            body: file,
          }
        );

      if (!uploadResponse.ok) {
        throw new Error(
          "Image could not be uploaded to storage."
        );
      }

      const finalizeResponse =
        await fetch(
          "/api/owner/media",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              Authorization:
                `Bearer ${token}`,
            },

            body:
              JSON.stringify({
                action:
                  "finalize",

                mediaId:
                  prepareData.mediaId,

                storagePath:
                  prepareData.storagePath,

                title:
                  file.name.replace(
                    /\.[^.]+$/,
                    ""
                  ),

                file:
                  fileInfo,
              }),
          }
        );

      const finalizeData =
        await finalizeResponse.json();

      if (
        !finalizeResponse.ok ||
        !finalizeData.success
      ) {
        throw new Error(
          finalizeData.error ||
            "Image upload could not be finalized."
        );
      }

      updateField(
        "imageMediaId",
        finalizeData.mediaId
      );

      setMessage(
        "Product image uploaded successfully."
      );

      await loadData();

    } catch (error) {
      setError(
        error instanceof Error
          ? error.message
          : "Product image upload failed."
      );
    } finally {
      setUploadingImage(false);
    }
  }

  async function saveProduct() {
    if (!user) return;

    setBusy(true);
    setError("");
    setMessage("");

    try {
      const token =
        await user.getIdToken();

      const response =
        await fetch(
          "/api/owner/products",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              Authorization:
                `Bearer ${token}`,
            },

            body:
              JSON.stringify({
                action:
                  form.productId
                    ? "update"
                    : "create",

                productId:
                  form.productId,

                title:
                  form.title,

                description:
                  form.description,

                sku:
                  form.sku,

                category:
                  form.category,

                price:
                  Number(
                    form.price
                  ),

                stock:
                  Number(
                    form.stock
                  ),

                shippingCharge:
                  Number(
                    form.shippingCharge
                  ),

                active:
                  form.active,

                imageMediaId:
                  form.imageMediaId,
              }),
          }
        );

      const result =
        await response.json();

      if (
        !response.ok ||
        !result.success
      ) {
        throw new Error(
          result.error ||
            "Product could not be saved."
        );
      }

      setMessage(
        result.message ||
          "Product saved."
      );

      setForm(blankForm);

      await loadData();
    } catch (error) {
      setError(
        error instanceof Error
          ? error.message
          : "Product could not be saved."
      );
    } finally {
      setBusy(false);
    }
  }

  async function deleteProduct(
    product: Product
  ) {
    if (
      !user ||
      !window.confirm(
        `Delete "${product.title}"?`
      )
    ) {
      return;
    }

    setBusy(true);
    setError("");
    setMessage("");

    try {
      const token =
        await user.getIdToken();

      const response =
        await fetch(
          "/api/owner/products",
          {
            method: "POST",

            headers: {
              "Content-Type":
                "application/json",

              Authorization:
                `Bearer ${token}`,
            },

            body:
              JSON.stringify({
                action:
                  "delete",

                productId:
                  product.productId,
              }),
          }
        );

      const result =
        await response.json();

      if (
        !response.ok ||
        !result.success
      ) {
        throw new Error(
          result.error ||
            "Product could not be deleted."
        );
      }

      setMessage(
        result.message ||
          "Product deleted."
      );

      if (
        form.productId ===
        product.productId
      ) {
        setForm(
          blankForm
        );
      }

      await loadData();
    } catch (error) {
      setError(
        error instanceof Error
          ? error.message
          : "Product could not be deleted."
      );
    } finally {
      setBusy(false);
    }
  }

  if (loading) {
    return (
      <main className="min-h-screen bg-black px-6 py-12 text-white">
        Loading Product Manager...
      </main>
    );
  }

  if (!user) {
    return (
      <main className="min-h-screen bg-black px-6 py-12 text-white">
        <h1 className="text-4xl font-black">
          Product Manager
        </h1>

        <p className="mt-4 text-white/50">
          Sign in with the owner account.
        </p>
      </main>
    );
  }

  if (!isOwner) {
    return (
      <main className="min-h-screen bg-black px-6 py-12 text-white">
        Owner access only.
      </main>
    );
  }

  const selectedImage =
    media.find(
      (item) =>
        item.mediaId ===
        form.imageMediaId
    );

  return (
    <main className="min-h-screen bg-[#050505] px-5 py-10 text-white sm:px-8">
      <div className="mx-auto max-w-7xl">

        <div className="flex flex-wrap items-center justify-between gap-4">
          <div>
            <p className="text-xs font-black uppercase tracking-[0.2em] text-red-400">
              SOLO BEATS STORE
            </p>

            <h1 className="mt-2 text-4xl font-black sm:text-6xl">
              Product Manager
            </h1>

            <p className="mt-3 max-w-3xl text-white/50">
              Create physical products, choose product images,
              set prices, stock, shipping charges and public
              availability.
            </p>
          </div>

          <Link
            href="/developer/control-room"
            className="rounded-xl border border-white/10 bg-white/5 px-5 py-3 font-black"
          >
            Control Room
          </Link>
        </div>

        {message ? (
          <div className="mt-6 rounded-2xl border border-emerald-400/25 bg-emerald-400/10 p-4 text-emerald-200">
            {message}
          </div>
        ) : null}

        {error ? (
          <div className="mt-6 rounded-2xl border border-red-400/25 bg-red-400/10 p-4 text-red-200">
            {error}
          </div>
        ) : null}

        <section className="mt-8 rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8">
          <div className="flex flex-wrap items-center justify-between gap-4">
            <h2 className="text-3xl font-black">
              {form.productId
                ? "Edit Product"
                : "Add Product"}
            </h2>

            {form.productId ? (
              <button
                type="button"
                onClick={clearForm}
                className="rounded-xl border border-white/10 bg-white/5 px-4 py-3 font-black"
              >
                New Product
              </button>
            ) : null}
          </div>

          <div className="mt-6 grid gap-5 md:grid-cols-2">

            <label className="grid gap-2">
              <span className="text-sm font-black">
                Product title
              </span>

              <input
                value={form.title}
                onChange={(event) =>
                  updateField(
                    "title",
                    event.target.value
                  )
                }
                className="rounded-xl border border-white/10 bg-black px-4 py-3"
                placeholder="SOLO BEATS T-Shirt"
              />
            </label>

            <label className="grid gap-2">
              <span className="text-sm font-black">
                SKU (OPTIONAL)
              </span>

              <input
                value={form.sku}
                onChange={(event) =>
                  updateField(
                    "sku",
                    event.target.value
                  )
                }
                className="rounded-xl border border-white/10 bg-black px-4 py-3"
                placeholder="Leave blank if you do not have one yet"
              />
            </label>

            <label className="grid gap-2">
              <span className="text-sm font-black">
                Category
              </span>

              <input
                value={form.category}
                onChange={(event) =>
                  updateField(
                    "category",
                    event.target.value
                  )
                }
                className="rounded-xl border border-white/10 bg-black px-4 py-3"
                placeholder="Apparel"
              />
            </label>

            <label className="grid gap-2">
              <span className="text-sm font-black">
                Price ($)
              </span>

              <input
                type="number"
                min="0"
                step="0.01"
                value={form.price}
                onChange={(event) =>
                  updateField(
                    "price",
                    event.target.value
                  )
                }
                className="rounded-xl border border-white/10 bg-black px-4 py-3"
              />
            </label>

            <label className="grid gap-2">
              <span className="text-sm font-black">
                Stock quantity
              </span>

              <input
                type="number"
                min="0"
                step="1"
                value={form.stock}
                onChange={(event) =>
                  updateField(
                    "stock",
                    event.target.value
                  )
                }
                className="rounded-xl border border-white/10 bg-black px-4 py-3"
              />
            </label>

            <label className="grid gap-2">
              <span className="text-sm font-black">
                Shipping charge ($)
              </span>

              <input
                type="number"
                min="0"
                step="0.01"
                value={
                  form.shippingCharge
                }
                onChange={(event) =>
                  updateField(
                    "shippingCharge",
                    event.target.value
                  )
                }
                className="rounded-xl border border-white/10 bg-black px-4 py-3"
              />
            </label>

          </div>

          <label className="mt-5 grid gap-2">
            <span className="text-sm font-black">
              Description
            </span>

            <textarea
              rows={5}
              value={
                form.description
              }
              onChange={(event) =>
                updateField(
                  "description",
                  event.target.value
                )
              }
              className="rounded-xl border border-white/10 bg-black px-4 py-3"
              placeholder="Describe the product..."
            />
          </label>

          <label className="mt-5 flex items-center gap-3">
            <input
              type="checkbox"
              checked={form.active}
              onChange={(event) =>
                updateField(
                  "active",
                  event.target.checked
                )
              }
            />

            <span className="font-black">
              ACTIVE / VISIBLE FOR STORE
            </span>
          </label>

          <div className="mt-8">
            <h3 className="text-xl font-black">
              Product Image
            </h3>

            <p className="mt-1 text-sm text-white/45">
              Upload a new image from your device or choose one already stored in your Media Library.
            </p>

            <div className="mt-5">
              <label className="inline-flex cursor-pointer rounded-xl bg-red-600 px-5 py-3 font-black transition hover:bg-red-500">
                {uploadingImage
                  ? "UPLOADING..."
                  : "UPLOAD FROM DEVICE"}

                <input
                  type="file"
                  accept="image/*"
                  disabled={uploadingImage}
                  className="hidden"
                  onChange={(event) => {
                    const file =
                      event.target.files?.[0];

                    if (file) {
                      void uploadProductImage(
                        file
                      );
                    }

                    event.currentTarget.value =
                      "";
                  }}
                />
              </label>
            </div>

            {selectedImage?.previewUrl ? (
              <div className="mt-5">
                <img
                  src={
                    selectedImage.previewUrl
                  }
                  alt="Selected product"
                  className="h-52 w-52 rounded-2xl border border-red-500/40 object-cover"
                />
              </div>
            ) : null}

            <div className="mt-5 grid max-h-[520px] gap-4 overflow-y-auto sm:grid-cols-2 lg:grid-cols-4">
              {media.map(
                (item) => {
                  const selected =
                    form.imageMediaId ===
                    item.mediaId;

                  return (
                    <button
                      key={
                        item.mediaId
                      }
                      type="button"
                      onClick={() =>
                        updateField(
                          "imageMediaId",
                          item.mediaId
                        )
                      }
                      className={`rounded-2xl border p-3 text-left ${
                        selected
                          ? "border-red-500 bg-red-500/10"
                          : "border-white/10 bg-black"
                      }`}
                    >
                      {item.previewUrl ? (
                        <img
                          src={
                            item.previewUrl
                          }
                          alt={
                            item.title
                          }
                          className="aspect-square w-full rounded-xl object-cover"
                        />
                      ) : (
                        <div className="grid aspect-square place-items-center rounded-xl bg-white/5 text-white/30">
                          No Preview
                        </div>
                      )}

                      <p className="mt-3 truncate text-sm font-black">
                        {item.title}
                      </p>
                    </button>
                  );
                }
              )}
            </div>
          </div>

          <button
            type="button"
            disabled={busy}
            onClick={saveProduct}
            className="mt-8 rounded-xl bg-red-600 px-7 py-4 font-black transition hover:bg-red-500 disabled:opacity-50"
          >
            {busy
              ? "SAVING..."
              : form.productId
                ? "UPDATE PRODUCT"
                : "CREATE PRODUCT"}
          </button>
        </section>

        <section className="mt-10">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <h2 className="text-3xl font-black">
              Products
            </h2>

            <button
              type="button"
              disabled={busy}
              onClick={() =>
                void loadData()
              }
              className="rounded-xl border border-white/10 bg-white/5 px-4 py-3 font-black"
            >
              Refresh
            </button>
          </div>

          {products.length === 0 ? (
            <div className="mt-6 rounded-3xl border border-white/10 bg-white/[0.03] p-8 text-white/50">
              No physical products yet.
            </div>
          ) : (
            <div className="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {products.map(
                (product) => (
                  <article
                    key={
                      product.productId
                    }
                    className="overflow-hidden rounded-3xl border border-white/10 bg-white/[0.03]"
                  >
                    {product.imagePreviewUrl ? (
                      <img
                        src={
                          product.imagePreviewUrl
                        }
                        alt={
                          product.title
                        }
                        className="aspect-square w-full object-cover"
                      />
                    ) : null}

                    <div className="p-6">
                      <div className="flex flex-wrap items-center gap-2">
                        <span className="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-black">
                          {product.active
                            ? "ACTIVE"
                            : "HIDDEN"}
                        </span>

                        <span className="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-black">
                          STOCK {product.stock}
                        </span>
                      </div>

                      <h3 className="mt-4 text-2xl font-black">
                        {product.title}
                      </h3>

                      <p className="mt-2 text-sm text-white/45">
                        {product.category ||
                          "Uncategorized"}
                      </p>

                      <p className="mt-4 line-clamp-3 text-sm leading-6 text-white/55">
                        {product.description}
                      </p>

                      <div className="mt-5 text-2xl font-black">
                        ${product.price.toFixed(2)}
                      </div>

                      <p className="mt-1 text-sm text-white/45">
                        Shipping: $
                        {product.shippingCharge.toFixed(
                          2
                        )}
                      </p>

                      <div className="mt-6 flex gap-3">
                        <button
                          type="button"
                          onClick={() =>
                            editProduct(
                              product
                            )
                          }
                          className="rounded-xl bg-white px-4 py-3 font-black text-black"
                        >
                          EDIT
                        </button>

                        <button
                          type="button"
                          onClick={() =>
                            void deleteProduct(
                              product
                            )
                          }
                          className="rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 font-black text-red-300"
                        >
                          DELETE
                        </button>
                      </div>
                    </div>
                  </article>
                )
              )}
            </div>
          )}
        </section>

      </div>
    </main>
  );
}

